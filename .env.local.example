# ============================================
# AI Chat 环境变量配置
# ============================================
# 复制此文件为 .env.local 并填入你的 API Key
# cp .env.local.example .env.local

# ------ AI 模型提供商配置 ------
# 支持: dashscope (通义千问), zhipu (智谱GLM), baidu (文心一言), deepseek
AI_PROVIDER=dashscope

# ------ 通义千问 (阿里云 DashScope) ------
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-plus

# ------ 智谱 AI (GLM) ------
# 获取地址: https://open.bigmodel.cn/
# ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_MODEL=glm-4-flash

# ------ 百度文心一言 ------
# 获取地址: https://cloud.baidu.com/product/wenxinworkshop
# BAIDU_API_KEY=your_baidu_api_key_here
# BAIDU_SECRET_KEY=your_baidu_secret_key_here
# BAIDU_MODEL=ernie-bot-4

# ------ DeepSeek ------
# 获取地址: https://platform.deepseek.com/
# 文档: https://api-docs.deepseek.com/zh-cn/
# 注意: deepseek-chat/deepseek-reasoner 将于 2026/07/24 弃用
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash

# ------ 应用配置 ------
NEXT_PUBLIC_APP_NAME=AI Chat
NEXT_PUBLIC_APP_DESCRIPTION=智能 AI 对话助手
